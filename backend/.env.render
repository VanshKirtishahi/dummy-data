# ==============================================================
# RENDER PRODUCTION ENVIRONMENT CONFIGURATION
# Set these in your Render Dashboard: Environment -> Environment Variables
# ==============================================================
NODE_ENV=production
PORT=10000

# Connect to your production MongoDB cluster (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/prod_db?retryWrites=true&w=majority

# Point CORS to your production Vercel frontend URL
CORS_ORIGIN=https://dummy-mern-frontend.vercel.app
